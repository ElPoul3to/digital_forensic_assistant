# Copy to .env and adjust. Values here override config/*.yaml.
DFA_OLLAMA_BASE_URL=http://localhost:11434
DFA_GENERATOR_MODEL=hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q8_0
# Qdrant: a server URL (recommended: `make qdrant-server`, ~10x faster ingest, no RAM load on open)
# or an embedded path (no daemon, but ~50 chunks/s and only meant for tiny cases).
DFA_QDRANT_URL=http://localhost:6333
#DFA_QDRANT_PATH=data/qdrant
DFA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
DFA_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
DFA_DEVICE=cuda
# --- hardening (Phase 8) ---
#DFA_API_AUTH=auto              # auto | required | off  (see config/security.yaml)
#DFA_ENCRYPT_NEW_CASES=1        # per-case encryption at rest for every new case
#DFA_MASTER_KEY=change-me       # passphrase wrapping the case keys (else data/keys/master.key is generated)
# --- memory forensics ---
#DFA_VOL_OFFLINE=1              # Volatility 3: never fetch symbols online
#DFA_VOL_SYMBOLS=/opt/symbols   # extra Volatility symbol directory
